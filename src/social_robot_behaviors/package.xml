<?xml version="1.0"?>

<package format="3">
  <name>social_robot_behaviors</name>
  <version>0.0.1</version>
  <description>
    Social robot behavior manager for UR5e
  </description>
  <maintainer email="your@email.com">
    Manel Puig
  </maintainer>
  <license>Apache-2.0</license>

  <!-- Build -->
  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Dependencies -->

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>ur5e_interfaces</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>ament_index_python</depend>
  <exec_depend>social_robot_perception</exec_depend>
  <exec_depend>social_robot_hri</exec_depend>
  <exec_depend>python3</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>

</package>
